# syntax=docker/dockerfile:1.7
#
# Scalable RAG Backend — slim Python base, GPU via pip-installed NVIDIA libs.
#
# torch pulls in nvidia-cudnn-cu12, nvidia-cuda-runtime-cu12, etc. as deps.
# onnxruntime-gpu reuses those same libs. We register them via ldconfig so
# the dynamic linker finds them without relying on LD_LIBRARY_PATH.
# Falls back to CPU automatically when no GPU is attached.

ARG PYTHON_VERSION=3.12

# ----- Stage 1: builder -----
FROM python:${PYTHON_VERSION}-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        git \
        curl \
        libmagic1 \
        libjpeg-dev \
        zlib1g-dev \
        libfreetype6-dev \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt /app/requirements.txt

# Install all deps (torch pulls in CUDA 12 + cuDNN 9 wheels), then swap CPU
# onnxruntime for the GPU build pinned to a version that matches torch's CUDA/cuDNN.
# Use the CUDA-12 extra index URL to guarantee the right onnxruntime-gpu build.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel \
    && pip install -r requirements.txt \
    && pip uninstall -y onnxruntime \
    && pip install \
        --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/ \
        onnxruntime-gpu==1.20.1

# ----- Stage 2: runtime -----
FROM python:${PYTHON_VERSION}-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        libmagic1 \
        libgomp1 \
        libjpeg62-turbo \
        libfreetype6 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

# Register pip-installed NVIDIA libraries with the dynamic linker. ldconfig
# is more reliable than LD_LIBRARY_PATH — it works regardless of how the
# process is launched and doesn't get wiped by env-handling middleware.
RUN set -e \
    && NV_LIB_BASE=/opt/venv/lib/python3.12/site-packages/nvidia \
    && printf "%s\n" \
        "$NV_LIB_BASE/cudnn/lib" \
        "$NV_LIB_BASE/cuda_runtime/lib" \
        "$NV_LIB_BASE/cublas/lib" \
        "$NV_LIB_BASE/cufft/lib" \
        "$NV_LIB_BASE/curand/lib" \
        "$NV_LIB_BASE/cusparse/lib" \
        "$NV_LIB_BASE/cusolver/lib" \
        "$NV_LIB_BASE/nvjitlink/lib" \
        "$NV_LIB_BASE/nccl/lib" \
        "$NV_LIB_BASE/cuda_nvrtc/lib" \
        > /etc/ld.so.conf.d/nvidia-pip.conf \
    && ldconfig

# Non-root user.
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} app \
    && useradd -m -u ${APP_UID} -g ${APP_GID} -s /bin/bash app

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

COPY --chown=app:app . /app

RUN mkdir -p /app/data/uploads /app/data/logs /app/data/cache \
    && chown -R app:app /app/data

USER app

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
